# 复制为 .dev.vars（wrangler dev 会自动读取），或作为环境变量传给 worker/dev-server.mjs
# 这些都是可选项，全部留空也能跑，只是只能播放匿名可听的曲目

# 网易云 MUSIC_U cookie，等同于账号密码，别提交到仓库
MUSIC_U=

# 填了之后所有 /api/* 都要带 ?k=<API_TOKEN>
API_TOKEN=

# 多账号表（JSON 数组），例：
# ACCOUNTS_JSON=[{"name":"alice","password":"***","musicU":"***"}]
ACCOUNTS_JSON=

# 登录态签名密钥，不填会退化为用账号表做密钥
SESSION_SECRET=

# 是否要求登录 / 是否开启口令门
REQUIRE_LOGIN=false
REQUIRE_PASS=false
PASSWORD=

# 允许的跨域来源，逗号分隔；本地调试可用 *
ALLOWED_ORIGIN=*
